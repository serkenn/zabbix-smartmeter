                </dashboard>
            </dashboards>
            <macros>
                <macro>
                    <macro>{$SMARTMETER.JSON_PATH}</macro>
                    <value>/var/lib/zabbix/smartmeter.json</value>
                    <description>zabbix-smartmeter が書き出す JSON ファイルのパス。</description>
                </macro>
                <macro>
                    <macro>{$SMARTMETER.POWER.MAX}</macro>
                    <value>5000</value>
                    <description>瞬時電力の警告閾値 [W]。契約容量に合わせて調整する。</description>
                </macro>
                <macro>
                    <macro>{$SMARTMETER.STALE}</macro>
                    <value>10m</value>
                    <description>データが更新されない状態を異常とみなすまでの時間。</description>
                </macro>
            </macros>
        </template>
