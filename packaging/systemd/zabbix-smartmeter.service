[Unit]
Description=Collect smart meter (B-route) metrics for Zabbix
Documentation=https://github.com/serkenn/zabbix-smartmeter
ConditionPathExists=/etc/sysconfig/zabbix-smartmeter

[Service]
Type=oneshot

# 既定値を先に置き、EnvironmentFileで上書きできるようにする（後勝ち）。
Environment=SMARTMETER_OUTPUT=/var/lib/zabbix/smartmeter.json
EnvironmentFile=/etc/sysconfig/zabbix-smartmeter

# Zabbix agentが読めるディレクトリを用意する。
# "+" を付けた行はサンドボックスの外で実行される。
# zabbix-agentが既に作っている場合は所有者とパーミッションに触らない。
ExecStartPre=+/bin/sh -c 'test -d /var/lib/zabbix || install -d -m 0755 /var/lib/zabbix'
ExecStart=/usr/bin/zabbix-smartmeter --json --log stderr
TimeoutStartSec=180

# Wi-SUNモジュールへのアクセス権の都合でrootで動かすが、権限は以下で絞り込む。
# 非rootで動かす方法は docs/almalinux.md を参照。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zabbix
PrivateTmp=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# /var/lib/zabbix は zabbix-agent が zabbix:zabbix 0755 で作るため、
# rootであっても書き込みには CAP_DAC_OVERRIDE が要る。これを落とすと
# "failed to create temp file in \"/var/lib/zabbix\": permission denied" になる。
# 非rootで動かす場合（docs/almalinux.md 参照）は所有者が一致するため不要。
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=

# シリアルポートのみアクセスを許可する。
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw

[Install]
WantedBy=multi-user.target
